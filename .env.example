# Telegram credentials
TELEGRAM_API_ID=replace-me
TELEGRAM_API_HASH=replace-me

# OneBot 11 / NapCat reverse WebSocket
SIDEKICK_ONEBOT_TOKEN=replace-with-a-separate-random-64-character-value
SIDEKICK_ONEBOT_SELF_ID=123456789
SIDEKICK_ONEBOT_PUBLISH_HOST=127.0.0.1
SIDEKICK_ONEBOT_PUBLISH_PORT=18867
SIDEKICK_ONEBOT_MAX_OUTPUT_CHARS=3900

# WeChat Linux connector
SIDEKICK_WECHAT_URL=http://127.0.0.1:18188
SIDEKICK_WECHAT_TOKEN=replace-with-the-connector-bearer-token
SIDEKICK_WECHAT_STATE_PATH=~/.sidekick/wechat.db
SIDEKICK_WECHAT_RECONNECT_DELAY=2
SIDEKICK_WECHAT_HOST_TOKEN=
SIDEKICK_WECHAT_PEER_TOKEN=
SIDEKICK_WECHAT_MAX_OUTPUT_CHARS=3900

# Standalone service clients. Compose replaces the URLs with internal DNS names.
SIDEKICK_PI_URL=http://127.0.0.1:8790
SIDEKICK_PI_RUN_TIMEOUT=300
SIDEKICK_PI_TOKEN=replace-with-a-random-64-character-value
SIDEKICK_HINDSIGHT_URL=http://127.0.0.1:18888
SIDEKICK_HINDSIGHT_TIMEOUT=90

# Internal authenticated channel-status endpoints (not host-published by Compose)
SIDEKICK_OPS_PORT=8781
SIDEKICK_TELEGRAM_INSTANCE_ID=telegram-default
SIDEKICK_ONEBOT_INSTANCE_ID=qq-default
SIDEKICK_WECHAT_HOST_INSTANCE_ID=wechat-host
SIDEKICK_WECHAT_PEER_INSTANCE_ID=wechat-peer

# Memory capture and Dream scheduling
SIDEKICK_MEMORY_DREAM_LOOKBACK_HOURS=24
SIDEKICK_MEMORY_DREAM_OVERLAP_SECONDS=600
SIDEKICK_MEMORY_INGESTION_SETTLEMENT_SECONDS=30
SIDEKICK_MEMORY_INGESTION_MAX_MESSAGES=500
SIDEKICK_MEMORY_INGESTION_MAX_THREAD_MESSAGES=100
SIDEKICK_MEMORY_SEGMENT_IDLE_SECONDS=300
SIDEKICK_MEMORY_SEGMENT_MAX_SPAN_SECONDS=3600
SIDEKICK_MEMORY_SEGMENT_MAX_EVENTS=30
SIDEKICK_MEMORY_SEGMENT_MAX_CHARS=4000
SIDEKICK_MEMORY_INGESTION_RETAIN_CONCURRENCY=4
SIDEKICK_MEMORY_INGESTION_PREPROCESS_CONCURRENCY=12
SIDEKICK_MEMORY_DREAM_CYCLE_BUDGET_SECONDS=50
SIDEKICK_MEMORY_DREAM_SCOPE_TIMEOUT_SECONDS=300
SIDEKICK_MEMORY_DREAM_CRON=0 * * * *
SIDEKICK_MEMORY_DREAM_CONCURRENCY=2
SIDEKICK_MEMORY_DREAM_SCOPE_BATCH_SIZE=20
SIDEKICK_MEMORY_INGESTION_LEASE_SECONDS=3600
SIDEKICK_MEMORY_INGESTION_RETRY_ATTEMPTS=3
SIDEKICK_MEMORY_INGESTION_MAX_RETRY_DELAY=30
SIDEKICK_MEMORY_CONTINUOUS_POLL_SECONDS=10
SIDEKICK_MEMORY_CONTINUOUS_CONCURRENCY=2
SIDEKICK_MEMORY_CONTINUOUS_SCOPE_BATCH_SIZE=20

# Telegram AI integration
SIDEKICK_AI_EDIT_CADENCE=4.0
SIDEKICK_AI_DELEGATED_COOLDOWN=30
SIDEKICK_MEMORY_COMMAND_DELETE_DELAY=3
