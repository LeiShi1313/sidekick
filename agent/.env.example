# OpenAI-compatible provider used by Pi
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=replace-me
EXA_API_KEY=replace-with-your-exa-api-key
AI_CHAT_MODEL=replace-me
AI_REASONING_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=4000
AI_CONTEXT_WINDOW=128000
AI_REQUEST_TIMEOUT=90

# Shared only with trusted clients of the private Pi HTTP service
PI_AGENT_TOKEN=replace-with-a-random-64-character-value

# Loopback-only published ports
PI_AGENT_EXPOSE_PORT=18790
PLAYGROUND_REQUEST_TIMEOUT=300
PLAYGROUND_SYSTEM_PROMPT=

# Optional Channels dashboard polling. Adapter URLs accept JSON or id=url pairs;
# leave blank to use the four internal Docker endpoints on port 8781. If the root
# adapter stack changes SIDEKICK_OPS_PORT, set explicit URLs here with that port;
# the two Compose projects use separate environment files.
PLAYGROUND_CHANNEL_ADAPTER_URLS=
PLAYGROUND_CHANNEL_POLL_INTERVAL=2
PLAYGROUND_CHANNEL_SOURCE_TIMEOUT=5
PLAYGROUND_CHANNEL_BANK_CACHE_TTL=15
