# OpenAI-compatible provider used by Pi
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=replace-me
EXA_API_KEY=replace-with-your-exa-api-key
AI_CHAT_MODEL=replace-me
# Optional read-only Codex login. The container UID 10001 must be able to read
# this single file. When omitted or unusable, Exa is the primary web search.
CODEX_AUTH_FILE=/home/replace-me/.codex/auth.json
# Omit to disable paid image generation.
AI_IMAGE_MODEL=gpt-image-2
AI_REASONING_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=4000
AI_CONTEXT_WINDOW=128000
AI_REQUEST_TIMEOUT=90
AI_IMAGE_REQUEST_TIMEOUT=180

# Optional SOCKS5 or HTTP CONNECT proxy for outbound page fetches
# (fetch_content). Accepts socks5://, socks5h://, http://, and https:// URLs
# with optional user:pass credentials. When unset, fetches connect directly.
WEB_EGRESS_PROXY=

# Hosted TaiBu MCP server used for divination tools
TAIBU_MCP_URL=https://suanming.leishi.xyz/mcp
TAIBU_MCP_REQUEST_TIMEOUT_MS=30000

# Stable HMAC key for model-facing identity aliases; do not reuse an API token.
PI_IDENTITY_ALIAS_KEY=replace-with-a-random-64-character-value

# Unique credentials for each private Pi client.
PI_AGENT_TELEGRAM_TOKEN=replace-with-a-unique-random-64-character-value
PI_AGENT_ONEBOT_TOKEN=replace-with-a-unique-random-64-character-value
PI_AGENT_WECHAT_HOST_TOKEN=replace-with-a-unique-random-64-character-value
PI_AGENT_WECHAT_PEER_TOKEN=replace-with-a-unique-random-64-character-value
PI_AGENT_PLAYGROUND_TOKEN=replace-with-a-unique-random-64-character-value

# Restrict each WeChat credential to one percent-encoded connector account.
PI_AGENT_WECHAT_HOST_SCOPE_PREFIX=wechat:account:replace-with-host-account-id:
PI_AGENT_WECHAT_PEER_SCOPE_PREFIX=wechat:account:replace-with-peer-account-id:

# Separate credentials for the memory gateway and adapter status endpoints.
MEMORY_API_TOKEN=replace-with-a-separate-random-64-character-value
SIDEKICK_OPS_TOKEN=replace-with-a-separate-random-64-character-value

# Loopback-only published ports
PI_AGENT_EXPOSE_PORT=18790
PLAYGROUND_REQUEST_TIMEOUT=300
PLAYGROUND_SYSTEM_PROMPT=

# Optional Channels dashboard polling. Adapter URLs accept JSON or id=url pairs;
# leave blank to use the four internal Docker endpoints on port 8781. If the root
# adapter stack changes SIDEKICK_OPS_PORT, set explicit URLs here with that port;
# the two Compose projects use separate environment files.
PLAYGROUND_CHANNEL_ADAPTER_URLS=
PLAYGROUND_CHANNEL_POLL_INTERVAL=2
PLAYGROUND_CHANNEL_SOURCE_TIMEOUT=5
PLAYGROUND_CHANNEL_BANK_CACHE_TTL=15

# Optional per-user tool grants (JSON). Set TOOL_GRANTS_FILE to a readable host
# path and PI_AGENT_TOOL_GRANTS_FILE to /run/secrets/tool-grants.json, then
# recreate pi-agent to apply. Tokens accept tool names (web_search,
# fetch_content, code_exec, image_generate, mcp) or groups (web, code, images,
# mcp, memory); deny wins over allow. Leave both blank to disable.
TOOL_GRANTS_FILE=
PI_AGENT_TOOL_GRANTS_FILE=
