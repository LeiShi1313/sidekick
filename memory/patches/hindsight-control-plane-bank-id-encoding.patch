diff --git a/hindsight-control-plane/tests/app/api/graph/route.test.ts b/hindsight-control-plane/tests/app/api/graph/route.test.ts
new file mode 100644
index 0000000..2fe8d20
--- /dev/null
+++ b/hindsight-control-plane/tests/app/api/graph/route.test.ts
@@ -0,0 +1,44 @@
+import type { NextRequest } from "next/server";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const { dataplaneBankUrl } = vi.hoisted(() => ({
+  dataplaneBankUrl: vi.fn(
+    (bankId: string, suffix: string) =>
+      `http://localhost:8888/v1/default/banks/${encodeURIComponent(bankId)}${suffix}`
+  ),
+}));
+
+vi.mock("@/lib/hindsight-client", () => ({
+  dataplaneBankUrl,
+  getDataplaneHeaders: vi.fn(() => ({})),
+}));
+
+import { GET } from "@/app/api/graph/route";
+
+function makeRequest(bankId: string): NextRequest {
+  const query = new URLSearchParams({ bank_id: bankId, type: "world", limit: "1000" });
+  return { nextUrl: new URL(`http://localhost/api/graph?${query}`) } as unknown as NextRequest;
+}
+
+describe("GET /api/graph", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("preserves percent escapes in bank IDs when building the dataplane path", async () => {
+    const bankId = "wechat:account:owner:chat:49277108357%40chatroom";
+    const fetchSpy = vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(JSON.stringify({ nodes: [], edges: [] }), {
+        status: 200,
+        headers: { "Content-Type": "application/json" },
+      })
+    );
+
+    await GET(makeRequest(bankId));
+
+    expect(fetchSpy).toHaveBeenCalledWith(
+      `http://localhost:8888/v1/default/banks/${encodeURIComponent(bankId)}/graph?type=world&limit=1000`,
+      { headers: {} }
+    );
+  });
+});
